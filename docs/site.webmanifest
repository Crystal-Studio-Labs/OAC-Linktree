{
  "name": "Odisha Anime Community",
  "short_name": "OAC Links",
  "description": "Official Link Portal for Odisha Anime Community. Event Passes, Talent Auditions, Stalls & Community Channels.",
  "start_url": "./",
  "scope": "./",
  "id": "/OAC-Linktree/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "window-controls-overlay",
    "minimal-ui"
  ],
  "background_color": "#0C0C0C",
  "theme_color": "#0C0C0C",
  "orientation": "portrait-primary",
  "categories": [
    "entertainment",
    "social",
    "events"
  ],
  "icons": [
    {
      "src": "./favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "./favicon.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./images/screenshots/screenshot-mobile-1.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Odisha Anime Community Mobile Hub & Event Passes"
    },
    {
      "src": "./images/screenshots/screenshot-mobile-2.png",
      "sizes": "540x1170",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Event Passes, Stalls, Auditions & Social Channels"
    },
    {
      "src": "./images/screenshots/screenshot-desktop-1.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Odisha Anime Community Official Desktop Portal"
    }
  ]
}
